# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (cloud project in eu-central-1; locally the values from `npm run db:status`) ---
# Publishable key (sb_publishable_...): safe in the browser, access limited by RLS
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): server only (api/*), bypasses RLS – never prefix with VITE_
SUPABASE_SECRET_KEY=
# Server-side Supabase URL for api/ (falls back to VITE_SUPABASE_URL)
SUPABASE_URL=
# Database password, only needed for the Supabase CLI (db push)
DB_PW=

# --- Team PIN (server only): HMAC key for PIN hashes; changing it invalidates every team PIN ---
# Generate with: openssl rand -hex 32
PIN_PEPPER=

# --- Anthropic (server only) ---
ANTHROPIC_API_KEY=

# --- Debug view /api/scan on Vercel: comma-separated account emails (locally always open) ---
DEBUG_USERS=

# --- Amazon Polly, dictation voice (server only; IAM user with polly:SynthesizeSpeech only) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1

# --- Langfuse (server only, EU cloud) ---
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Local development: create .env.development.local (gitignored) with the local
# VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY from `npm run db:status`.
# It overrides this file in `npm run dev` only. See README.md.
