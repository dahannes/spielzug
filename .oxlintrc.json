{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "import/no-cycle": "error"
  },
  "overrides": [
    {
      "files": ["shared/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [{ "regex": "^(\\.\\./)+(src|api)/", "message": "shared/ is used by browser and server: it imports neither." }] }]
      }
    },
    {
      "files": ["src/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [{ "regex": "^(\\.\\./)+api/", "message": "The browser talks to api/ over HTTP only (src/lib/api.ts)." }] }]
      }
    },
    {
      "files": ["api/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [{ "regex": "^(\\.\\./)+src/", "message": "Server code must not pull in browser code; share via shared/." }] }]
      }
    },
    {
      "files": ["src/components/**", "src/lib/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [{ "regex": "^(\\.\\./)+(features|app)/", "message": "components/ and lib/ are generic: they import no feature or app code." }] }]
      }
    }
  ]
}
