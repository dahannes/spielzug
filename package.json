{
  "name": "spielzug",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "version": "1.6.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host",
    "dev:cert": "mkdir -p .certs && mkcert -cert-file .certs/dev.pem -key-file .certs/dev-key.pem localhost 127.0.0.1 $(ipconfig getifaddr en0)",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:db": "supabase test db",
    "test:mutation": "stryker run",
    "quality": "knip && jscpd",
    "quality:report": "node scripts/quality-report.ts",
    "db:reset": "supabase db reset && npm run db:types",
    "db:types": "supabase gen types typescript --local > shared/database.types.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:new": "supabase migration new",
    "db:diff": "supabase db diff",
    "db:push:dry": "supabase db push --dry-run --remote",
    "backup:prod": "node scripts/backup-prod.ts",
    "release": "commit-and-tag-version",
    "deploy:prod": "git diff --quiet && git diff --cached --quiet || { echo 'Uncommitted changes – commit (and release) first.'; exit 1; } && npx vercel deploy --prod --build-env APP_COMMIT=$(git rev-parse --short HEAD)",
    "prepare": "simple-git-hooks",
    "check": "npm run lint && npm run quality && npm run typecheck && npm test && npm run test:db && npm run test:e2e",
    "check:fast": "npm run lint && npm run quality && npm run typecheck && vitest run shared src"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@aws-sdk/client-polly": "^3.1167.0",
    "@fontsource/b612": "^5.3.0",
    "@fontsource/b612-mono": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.2.6",
    "@langfuse/otel": "^6.1.1",
    "@langfuse/tracing": "^6.1.1",
    "@mediapipe/tasks-vision": "^0.10.14",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.1",
    "@opentelemetry/otlp-exporter-base": "^0.223.1",
    "@opentelemetry/sdk-trace-node": "^2.12.1",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "@techstark/opencv-js": "^4.12.0-release.1",
    "motion": "^14.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "^1.65.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "commit-and-tag-version": "13.3.0",
    "jscpd": "^5.4.3",
    "knip": "^6.45.1",
    "oxlint": "^1.93.0",
    "simple-git-hooks": "2.14.0",
    "supabase": "^3.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "simple-git-hooks": {
    "commit-msg": "npx --no -- commitlint --edit \"$1\"",
    "pre-push": "npm run check:fast"
  }
}
